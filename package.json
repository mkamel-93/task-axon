{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "clear-build": "rm -rf public/build",
        "build": "npm run clear-build && vite build",
        "dev": "npm run clear-build && vite",
        "prepare": "husky",
        "test:blade": "npx blade-formatter 'resources/views/**/*.blade.php' --check-formatted",
        "fix:blade": "npx blade-formatter 'resources/views/**/*.blade.php' --write"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.16.0",
        "concurrently": "^9.0.1",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vite-plugin-manifest-sri": "^0.2.0"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.6",
        "vue": "^3.5.33"
    }
}
