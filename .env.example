# Start Docker Configuration

# End Docker Configuration

# ----------------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------------
APP_NAME=task-axon
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://${DOCKER_WEB_IP}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

DEBUGBAR_ENABLED=false

# ----------------------------------------------------------------------------------
# Logging & Debugging
# ----------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------------
TOGGLE_DATABASE_DEBUG=true
DB_CONNECTION=sqlite
DB_DATABASE=/database/sample.db

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ----------------------------------------------------------------------------------
# Services: Session, Queue, FileSystem, Broadcast and Cache
# ----------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_COOKIE="${APP_ENV}_${APP_NAME}"
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

CACHE_STORE=redis
TOGGLE_CACHE_DEBUG=false
TOGGLE_CACHE_ENABLED=false
TOGGLE_CACHE_TTL=3600

# ----------------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------------
REDIS_PREFIX="${APP_ENV}-"
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=P@ssw0rd
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=2

# ----------------------------------------------------------------------------------
# Mail Configuration
# ----------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="mostafakamel000@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------------
# External Services & APIs (AWS, etc.)
# -------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------------
# Frontend & Assets (Vite)
# ----------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_APP_URL="${APP_URL}"

